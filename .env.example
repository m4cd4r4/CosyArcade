# =============================================================================
# CosyArcade Environment Variables
# Copy this file to .env.local and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Local development:
DATABASE_URL="postgresql://postgres:password@localhost:5432/cosyarcade"

# Production (use connection pooling):
# DATABASE_URL="postgresql://user:password@host:5432/cosyarcade?pgbouncer=true"

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"

# Your site URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# JWT expiry in seconds (default: 30 days)
JWT_EXPIRY=2592000

# -----------------------------------------------------------------------------
# Twilio (SMS Verification)
# -----------------------------------------------------------------------------
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+61xxxxxxxxx"

# Australian alternative: ClickSend
# CLICKSEND_USERNAME="your-username"
# CLICKSEND_API_KEY="your-api-key"

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Get API key from https://resend.com/
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# From address (must be verified domain in Resend)
EMAIL_FROM="CosyArcade <noreply@cosyarcade.com>"

# -----------------------------------------------------------------------------
# Storage (Optional - for production)
# -----------------------------------------------------------------------------
# Vultr Object Storage (S3-compatible)
S3_ENDPOINT="https://syd1.vultrobjects.com"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_BUCKET="cosyarcade-assets"
S3_REGION="syd1"

# Or use local storage in development:
# STORAGE_TYPE="local"

# -----------------------------------------------------------------------------
# Site Configuration
# -----------------------------------------------------------------------------
# Site name
SITE_NAME="CosyArcade"

# Site URL for meta tags and emails
SITE_URL="https://cosyarcade.com"

# Default theme
DEFAULT_THEME="crt-glow"

# Max save states per user per game
MAX_SAVE_STATES=5

# Max save state size in bytes (5MB default)
MAX_SAVE_STATE_SIZE=5242880

# -----------------------------------------------------------------------------
# Age Verification
# -----------------------------------------------------------------------------
# Verification code expiry in minutes
VERIFICATION_CODE_EXPIRY=10

# Max verification attempts
MAX_VERIFICATION_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Analytics (Optional)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="cosyarcade.com"

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------
# Enable debug logging
# DEBUG=true

# Skip SMS verification in dev (use code "123456")
# SKIP_SMS_VERIFICATION=true

# Skip email verification in dev
# SKIP_EMAIL_VERIFICATION=true
